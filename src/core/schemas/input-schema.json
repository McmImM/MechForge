{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/MechForge/src/cli/schemas/input-schema.json",
    "title": "MechForge CLI JSON Input Schema",
    "description": "Schema for the MechForge CLI JSON input format.",
    "type": "object",
    "properties": {
        "cmd": {
            "type": "string",
            "enum": [
                "build",
                "exit",
                "solve"
            ]
        }
    },
    "required": [
        "cmd"
    ],
    "oneOf": [
        {
            "properties": {
                "cmd": {
                    "const": "build"
                },
                "mech": {
                    "$ref": "mech.json"
                }
            },
            "required": [
                "mech"
            ],
            "unevaluatedProperties": false
        },
        {
            "properties": {
                "cmd": {
                    "const": "exit"
                }
            },
            "unevaluatedProperties": false
        },
        {
            "properties": {
                "cmd": {
                    "const": "solve"
                },
                "solverConfig": {
                    "$ref": "solverConfig.json"
                }
            },
            "required": [
                "solverConfig"
            ],
            "unevaluatedProperties": false
        }
    ]
}